{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-receptionist-prototype",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "super-front-desk.sosham.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
